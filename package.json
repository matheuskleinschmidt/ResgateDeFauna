{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migration:create": "dotenv -- sequelize-cli migration:create --name",
    "migrate": "dotenv -- sequelize-cli db:migrate",
    "migrate:rollback": "dotenv -- sequelize-cli db:migrate:undo",
    "migrate:rollback:all": "dotenv -- sequelize-cli db:migrate:undo:all",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\"",
    "test:backend": "jest --coverage",
    "test:frontend": "vitest",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
